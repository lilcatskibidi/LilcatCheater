-- ======================================
-- 🔹 Auto Switch & Camera
-- ======================================
RunService.Heartbeat:Connect(function()
	if not toggleEnabled then return end
	if lockMode == "Auto" then
		local valid = lockedTarget
			and lockedTarget.Character
			and lockedTarget.Character:FindFirstChild("HumanoidRootPart")
			and lockedTarget.Character:FindFirstChildOfClass("Humanoid")
			and lockedTarget.Character:FindFirstChildOfClass("Humanoid").Health > 0
		local newTarget = getTargetAuto()
		if newTarget then
			if not lockedTarget or newTarget ~= lockedTarget then
				setNewTarget(newTarget)
			end
		elseif lockedTarget and not valid then
			unlockTarget()
		end
	end
end)

RunService.RenderStepped:Connect(function()
	if not (lockActive and lockedTarget) then return end
	local targetChar = lockedTarget.Character
	local targetHRP = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not (targetHRP and hrp) then return end

	local visiblePart = getVisibleTargetPart(lockedTarget) or targetHRP
	local lookAt = CFrame.lookAt(hrp.Position, Vector3.new(visiblePart.Position.X, hrp.Position.Y, visiblePart.Position.Z))
	hrp.CFrame = hrp.CFrame:Lerp(lookAt, 0.35)

	local camPos = hrp.Position - hrp.CFrame.LookVector * 8 + Vector3.new(0, 3, 0)
	local targetPos = visiblePart.Position + Vector3.new(0, cameraOffsetY, 0)
	Camera.CFrame = Camera.CFrame:Lerp(CFrame.lookAt(camPos, targetPos), 0.3)
end)

