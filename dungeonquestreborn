    CreateSettingRow(190, "Orbit Radius", "orbitRadius")
    CreateSettingRow(225, "Threat Scan Range", "scanRadius")
    CreateSettingRow(260, "Max Dodge Dist.", "maxDodgeDistance")
    CreateSettingRow(295, "Underground Depth", "undergroundDepth")

    task.spawn(function()
        while true do
            if not parentTarget:FindFirstChild("AutoFarmGUI_Enhanced") then break end
            local found = GetAllNPCs()
            npcCount.Text = "Target NPCs: " .. #found
            
            dodgeStatus.Text = "Evasion: " .. currentEvasionStatusText
            if currentEvasionStatusText == "BILLBOARD LOCK" then
                dodgeStatus.TextColor3 = Color3.fromRGB(255, 50, 255)
            elseif isDodging then
                dodgeStatus.TextColor3 = Color3.fromRGB(255, 120, 0)
            else
                dodgeStatus.TextColor3 = Color3.fromRGB(100, 200, 255)
            end

            if isFarming then
                if billboardLockTarget then
                    status.Text = "Locked: Billboard"
                    status.TextColor3 = Color3.fromRGB(255, 100, 255)
                elseif currentTarget then
                    status.Text = "Target: " .. string.sub(currentTarget.Name, 1, 14)
