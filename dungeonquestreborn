-- State variables
local currentTarget = nil
local isFarming = false
local allNPCs = {}
local angle = 0
local expandedHitboxes = {}
local npcCache = {}
local lastScanTime = 0
local foundNPCPositions = {}
local knownRooms = {}

-- CACHE SYSTEM - Get ALL NPCs with caching
local function GetAllNPCs()
    local currentTime = tick()
    
    -- Return cached results if still valid
    if #npcCache > 0 and (currentTime - lastScanTime) < config.cacheTimeout then
        return npcCache
    end
    
    local npcs = {}
    local dungeonFolder = Workspace:FindFirstChild("dungeon")
    if not dungeonFolder then 
        npcCache = {}
        return npcs 
    end
    
    foundNPCPositions = {}
    
    for _, model in pairs(dungeonFolder:GetChildren()) do
        if model:IsA("Model") then
            local enemyFolder = model:FindFirstChild("enemyFolder")
            if enemyFolder then
                local roomName = model.Name
                for _, npc in pairs(enemyFolder:GetChildren()) do
                    if npc:IsA("Model") then
                        local humanoid = npc:FindFirstChildOfClass("Humanoid")
                        if humanoid and humanoid.Health > 0 then
                            table.insert(npcs, npc)
                            -- Cache NPC position
                            local npcRoot = GetNPCRoot(npc)
                            if npcRoot then
                                foundNPCPositions[npc] = npcRoot.Position
                                knownRooms[roomName] = true
                            end
                        end
                    end
                end
            else
                local humanoid = model:FindFirstChildOfClass("Humanoid")
                if humanoid and humanoid.Health > 0 then
                    table.insert(npcs, model)
                    local npcRoot = GetNPCRoot(model)
                    if npcRoot then
                        foundNPCPositions[model] = npcRoot.Position
                    end
                end
            end
        end
    end
    
    -- Update cache
    npcCache = npcs
    lastScanTime = currentTime
    
    return npcs
end

-- Get cached NPC position
local function GetCachedNPCPosition(npc)
    if foundNPCPositions[npc] then
        return foundNPCPositions[npc]
    end
    
    -- If not in cache, try to get it
    local npcRoot = GetNPCRoot(npc)
    if npcRoot then
        foundNPCPositions[npc] = npcRoot.Position
        return npcRoot.Position
    end
    
    return nil
end

-- EXPAND NPC HITBOX
local function ExpandNPCHitbox(npc)
    if not npc then return end
    
    -- Check if already expanded
    if expandedHitboxes[npc] then return end
    
    local humanoid = npc:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    
    local rootPart = GetNPCRoot(npc)
    if not rootPart then return end
    
    -- Create invisible hitbox expander
    local expander = Instance.new("Part")
    expander.Name = "HitboxExpander"
    expander.Size = Vector3.new(config.hitboxSize, config.hitboxSize * 0.8, config.hitboxSize)
    expander.Transparency = 1
    expander.CanCollide = false
    expander.Massless = true
    expander.Anchored = false
    expander.Material = Enum.Material.Plastic
    expander.Parent = npc
    
    -- Weld to root part
    local weld = Instance.new("Weld")
    weld.Part0 = rootPart
    weld.Part1 = expander
    weld.C0 = CFrame.new(0, 0, 0)
    weld.Parent = expander
    
    -- Store reference
    expandedHitboxes[npc] = {
        expander = expander,
        weld = weld,
        rootPart = rootPart
    }
    
    -- Make all parts massless for performance
    for _, child in pairs(npc:GetDescendants()) do
        if child:IsA("BasePart") and child.Name ~= "HitboxExpander" then
            child.CanCollide = false
            child.Massless = true
        end
    end
    
    return expander
end

-- Expand hitboxes for all NPCs (optimized)
local function ExpandAllHitboxes()
    local npcs = GetAllNPCs()
    for _, npc in pairs(npcs) do
        ExpandNPCHitbox(npc)
    end
end

-- Cleanup expanded hitboxes
local function CleanupHitboxes()
    for npc, data in pairs(expandedHitboxes) do
        if data and data.expander then
            data.expander:Destroy()
        end
    end
    expandedHitboxes = {}
end

-- Get character root part safely
local function GetCharacterRoot()
    local character = LocalPlayer.Character
    if not character then return nil end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then
        rootPart = character.PrimaryPart
    end
    if not rootPart then
        for _, child in pairs(character:GetChildren()) do
            if child:IsA("BasePart") and child.Name ~= "Head" then
                rootPart = child
                break
            end
        end
    end
    return rootPart
end

-- Get NPC root part safely
local function GetNPCRoot(npc)
    if not npc then return nil end
    
    local rootPart = npc:FindFirstChild("HumanoidRootPart")
    if not rootPart then
        rootPart = npc.PrimaryPart
    end
    if not rootPart then
        for _, child in pairs(npc:GetChildren()) do
            if child:IsA("BasePart") then
                rootPart = child
                break
            end
        end
    end
    return rootPart
end

-- Find nearest NPC from ALL NPCs (optimized)
local function FindNearestNPC()
    allNPCs = GetAllNPCs()
    if #allNPCs == 0 then return nil end
    
    -- Expand hitboxes for all NPCs
    ExpandAllHitboxes()
    
    local rootPart = GetCharacterRoot()
    if not rootPart then return nil end
    
    local nearest = nil
    local nearestDist = math.huge
    local playerPos = rootPart.Position
    
    -- Use cached positions for faster checking
    for _, npc in pairs(allNPCs) do
        local npcPos = GetCachedNPCPosition(npc)
        if npcPos then
            local dist = (playerPos - npcPos).Magnitude
            if dist < nearestDist then
                nearestDist = dist
                nearest = npc
            end
        end
    end
    
    return nearest
end

-- Check if position is safe
local function IsPositionSafe(position)
    local character = LocalPlayer.Character
    if not character then return true end
    
    local rootPart = GetCharacterRoot()
    if not rootPart then return true end
    
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
    raycastParams.FilterDescendantsInstances = {character}
    
    local rayOrigin = position + Vector3.new(0, 10, 0)
    local rayDirection = Vector3.new(0, -20, 0)
    
    local result = Workspace:Raycast(rayOrigin, rayDirection, raycastParams)
    
    if result and result.Instance and result.Instance.CanCollide then
        local distance = (position - result.Position).Magnitude
        if distance < 1 then
            return false
        end
    end
    
    return true
end

-- Find orbit position around enemy
local function GetOrbitPosition(enemyPos, playerPos, angleOffset)
    local direction = (playerPos - enemyPos)
    direction = Vector3.new(direction.X, 0, direction.Z).Unit
    
    if direction.Magnitude < 0.001 then
        direction = Vector3.new(1, 0, 0)
    end
    
    local perp = Vector3.new(-direction.Z, 0, direction.X)
    
    local orbitAngle = angle + angleOffset
    local orbitPos = enemyPos + 
        (direction * math.cos(orbitAngle) + perp * math.sin(orbitAngle)) * config.orbitRadius
    
    -- Add slight vertical variation
    orbitPos = orbitPos + Vector3.new(0, math.sin(orbitAngle * 2) * 0.5, 0)
    
    return orbitPos
end

-- Get equipped weapon
local function GetEquippedWeapon()
    local weaponEquipped = LocalPlayer:FindFirstChild("weaponEquipped")
    if not weaponEquipped then return nil end
    
    local weaponName = weaponEquipped.Value
    if not weaponName or weaponName == "none" then return nil end
    
    local character = LocalPlayer.Character
    if not character then return nil end
    
    for _, child in pairs(character:GetChildren()) do
        if child:IsA("Accessory") and child.Name == weaponName then
            return child
        end
    end
    return nil
end

-- Fire weapon swing
local function FireWeaponSwing()
    if not spamConfig.spamSwing then return false end
    
    local weapon = GetEquippedWeapon()
    if not weapon then return false end
    
    local swing = weapon:FindFirstChild("swing", true)
    if swing and swing:IsA("RemoteEvent") then
        swing:FireServer()
        return true
    end
    return false
end

-- SIMPLE RELIABLE MOVEMENT
local function MoveToPosition(targetPos)
    local rootPart = GetCharacterRoot()
    if not rootPart then return false end
    
    local distance = (targetPos - rootPart.Position).Magnitude
    if distance < 0.5 then return false end
    
    local direction = (targetPos - rootPart.Position).Unit
    local newPos = rootPart.Position + direction * math.min(distance, config.moveSpeed * 0.05)
    
    local lookAt = CFrame.new(rootPart.Position, targetPos)
    rootPart.CFrame = CFrame.new(newPos, Vector3.new(lookAt.LookVector.X, 0, lookAt.LookVector.Z))
    
    return true
end

-- Face target
local function FaceTarget(targetPos)
    local rootPart = GetCharacterRoot()
    if not rootPart then return end
    
    local lookAt = CFrame.new(rootPart.Position, targetPos)
    rootPart.CFrame = CFrame.new(rootPart.Position, Vector3.new(lookAt.LookVector.X, 0, lookAt.LookVector.Z))
end

-- Fire ability
local function FireAbility(slot)
    local tool = nil
    
    for _, v in pairs(LocalPlayer.Backpack:GetChildren()) do
        if v:FindFirstChild("abilitySlot") and v.abilitySlot.Value == slot then
            tool = v
            break
        end
    end
    
    if not tool and LocalPlayer.Character then
        for _, v in pairs(LocalPlayer.Character:GetChildren()) do
            if v:IsA("Tool") and v:FindFirstChild("abilitySlot") and v.abilitySlot.Value == slot then
                tool = v
                break
            end
        end
    end
    
    if not tool then return false end
    
    local localEvent = tool:FindFirstChild("localEvent")
    if localEvent then
        localEvent:Fire()
    end
    
    abilityUsed:FireServer(slot, tool)
    return true
end

-- Fire weapon
local function FireWeapon()
    if not LocalPlayer.Character then return false end
    
    local busyCasting = LocalPlayer.Character:FindFirstChild("busyCasting")
    if busyCasting and busyCasting.Value == true then return false end
    
    local weapon = nil
    for _, v in pairs(LocalPlayer.Character:GetChildren()) do
        if v:IsA("Accessory") and v:FindFirstChild("Weapon") then
            weapon = v
            break
        end
    end
    
    if not weapon then return false end
    
    local remoteEvent = weapon:FindFirstChildOfClass("RemoteEvent")
    if remoteEvent then
        remoteEvent:FireServer()
    end
    
    weaponUsed:FireServer()
    return true
end

-- Spam loop
local function StartSpam()
    local swingTimer = 0
    
    while isFarming do
        if spamConfig.spamQ then
            FireAbility("q")
        end
        
        if spamConfig.spamE then
            FireAbility("e")
        end
        
        if spamConfig.spamWeapon then
            FireWeapon()
        end
        
        if spamConfig.spamSwing then
            swingTimer = swingTimer + spamConfig.delay
            if swingTimer >= spamConfig.swingDelay then
                FireWeaponSwing()
                swingTimer = 0
            end
        end
        
        task.wait(spamConfig.delay)
    end
end

-- Camera lock-on
local function UpdateCamera()
    if not isFarming or not currentTarget then return end
    
    local rootPart = GetCharacterRoot()
    local npcRoot = GetNPCRoot(currentTarget)
    
    if rootPart and npcRoot then
        local targetPos = npcRoot.Position + Vector3.new(0, 4, 0)
        local currentPos = rootPart.Position + Vector3.new(0, 2, 0)
        local newCFrame = CFrame.new(currentPos, targetPos)
        Camera.CFrame = Camera.CFrame:Lerp(newCFrame, 0.25)
    end
end

-- Main farming loop
local function FarmingLoop()
    local moveTimer = 0
    local scanCooldown = 0
    
    while isFarming do
        -- Check character
        local character = LocalPlayer.Character
        if not character then
            task.wait(0.5)
            continue
        end
        
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then
            task.wait(0.5)
            continue
        end
        
        local rootPart = GetCharacterRoot()
        if not rootPart then
            task.wait(0.5)
            continue
        end
        
        -- Periodic scan for NPCs (reduces lag)
        scanCooldown = scanCooldown - config.checkInterval
        if scanCooldown <= 0 then
            allNPCs = GetAllNPCs()
            scanCooldown = config.scanInterval
        end
        
        -- Check current target
        if currentTarget then
            local npcHumanoid = currentTarget:FindFirstChildOfClass("Humanoid")
            if not npcHumanoid or npcHumanoid.Health <= 0 then
                -- Cleanup hitbox for dead NPC
                if expandedHitboxes[currentTarget] then
                    expandedHitboxes[currentTarget].expander:Destroy()
                    expandedHitboxes[currentTarget] = nil
                end
                currentTarget = nil
                task.wait(0.1)
                continue
            end
            
            local npcRoot = GetNPCRoot(currentTarget)
            if not npcRoot then
                currentTarget = nil
                task.wait(0.1)
                continue
            end
            
            -- Update camera
            UpdateCamera()
            
            local targetPos = npcRoot.Position
            local playerPos = rootPart.Position
            local distToTarget = (playerPos - targetPos).Magnitude
            
            -- Update angle for orbiting
            angle = angle + config.rotationSpeed * config.checkInterval
            
            -- Movement logic
            if distToTarget > config.maxDistance then
                -- Too far, move closer
                local towards = (targetPos - playerPos)
                towards = Vector3.new(towards.X, 0, towards.Z).Unit
                local movePos = targetPos - towards * (config.maxDistance - 5)
                MoveToPosition(movePos)
                
            elseif distToTarget < config.minDistance then
                -- Too close, back up
                local away = (playerPos - targetPos)
                away = Vector3.new(away.X, 0, away.Z).Unit
                local movePos = targetPos + away * (config.minDistance + 3)
                MoveToPosition(movePos)
            else
                -- In range, orbit
                local orbitPos = GetOrbitPosition(targetPos, playerPos, angle)
                
                -- Check if orbit position is safe
                if IsPositionSafe(orbitPos) then
                    MoveToPosition(orbitPos)
                else
                    -- Try opposite side
                    local oppositePos = GetOrbitPosition(targetPos, playerPos, angle + math.pi)
                    if IsPositionSafe(oppositePos) then
                        MoveToPosition(oppositePos)
                    end
                end
                
                -- Face target
                FaceTarget(targetPos)
            end
            
        else
            -- Find new target (use cached NPCs if possible)
            if #allNPCs == 0 then
                allNPCs = GetAllNPCs()
            end
            
            currentTarget = FindNearestNPC()
            
            if not currentTarget then
                -- If no NPC found, try a full rescan
                npcCache = {}
                allNPCs = GetAllNPCs()
                currentTarget = FindNearestNPC()
                
                if not currentTarget then
                    task.wait(0.5)
                    continue
                end
            end
            
            -- Expand hitbox for new target
            ExpandNPCHitbox(currentTarget)
            
            -- Move to target
            local npcRoot = GetNPCRoot(currentTarget)
            if npcRoot then
                local targetPos = npcRoot.Position
                local playerPos = rootPart.Position
                local distToTarget = (playerPos - targetPos).Magnitude
                
                if distToTarget > config.maxDistance then
                    local towards = (targetPos - playerPos)
                    towards = Vector3.new(towards.X, 0, towards.Z).Unit
                    local movePos = targetPos - towards * (config.maxDistance - 5)
                    MoveToPosition(movePos)
                end
            end
        end
        
        task.wait(config.checkInterval)
    end
end

-- Start auto-farm
local function StartAutoFarm()
    if isFarming then return end
    
    isFarming = true
    currentTarget = nil
    angle = 0
    npcCache = {}
    foundNPCPositions = {}
    knownRooms = {}
    
    -- Clean up old hitboxes
    CleanupHitboxes()
    
    print("🌾 Auto-Farm STARTED!")
    print("🔪 Weapon swing spam: " .. (spamConfig.spamSwing and "ON" or "OFF"))
    print("🌀 Orbiting enemies at " .. config.orbitRadius .. " studs radius")
    print("⚡ Movement speed: " .. config.moveSpeed)
    print("📏 Hitbox size: " .. config.hitboxSize .. " studs")
    print("📊 Scan interval: " .. config.scanInterval .. " seconds")
    
    task.spawn(StartSpam)
    task.spawn(FarmingLoop)
end

-- Stop auto-farm
local function StopAutoFarm()
    isFarming = false
    currentTarget = nil
    
    -- Cleanup hitboxes
    CleanupHitboxes()
    
    -- Clear cache
    npcCache = {}
    foundNPCPositions = {}
    knownRooms = {}
    
    print("⏹️ Auto-Farm STOPPED")
end

-- Toggle auto-farm
local function ToggleAutoFarm()
    if isFarming then
        StopAutoFarm()
    else
        StartAutoFarm()
    end
end

