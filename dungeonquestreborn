-- NPC Search
local function GetAllNPCs()
    local npcs = {}
    
    local function CheckModel(model)
        if not model:IsA("Model") or model == LocalPlayer.Character then return end
        if Players:GetPlayerFromCharacter(model) then return end
        
        local humanoid = model:FindFirstChildOfClass("Humanoid") or model:FindFirstChildOfClass("AnimationController")
        local root = GetNPCRoot(model)
        
        if root then
            if humanoid and humanoid:IsA("Humanoid") then
                if humanoid.Health > 0 then
                    table.insert(npcs, model)
                end
            else
                local healthVal = model:FindFirstChild("Health") or model:FindFirstChild("HP")
                if healthVal and healthVal:IsA("ValueBase") and healthVal.Value > 0 then
                    table.insert(npcs, model)
                end
            end
        end
    end

    local dungeonFolder = Workspace:FindFirstChild("dungeon") or Workspace:FindFirstChild("Dungeon")
    if dungeonFolder then
        for _, desc in pairs(dungeonFolder:GetDescendants()) do
            if desc:IsA("Model") then
                CheckModel(desc)
            end
        end
    else
        for _, child in pairs(Workspace:GetChildren()) do
            if child:IsA("Model") then
                CheckModel(child)
            end
        end
    end

    return npcs
end

-- Target Immortality Guard
local function PreventTargetDeath(npc)
    if not config.preventTargetDeath or not npc then return end
    local humanoid = npc:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.Health <= 1 then
        humanoid.Health = math.max(humanoid.Health, 10)
    end
    local healthVal = npc:FindFirstChild("Health") or npc:FindFirstChild("HP")
    if healthVal and healthVal:IsA("ValueBase") and healthVal.Value <= 1 then
        healthVal.Value = math.max(healthVal.Value, 10)
    end
end

-- Nearest Target Detector
local function FindNearestNPC()
    allNPCs = GetAllNPCs()
    if #allNPCs == 0 then return nil end

    local _, rootPart = GetPlayerControlInstance()
    if not rootPart then return nil end

    local nearest = nil
    local nearestDist = math.huge

    for _, npc in pairs(allNPCs) do
        local npcRoot = GetNPCRoot(npc)
        if npcRoot then
            local dist = (rootPart.Position - npcRoot.Position).Magnitude
            if dist < nearestDist then
                nearestDist = dist
                nearest = npc
            end
        end
    end
    return nearest
end

-- BILLBOARD GUI STATE SCANNER
local function FindBillboardStateLockTarget()
    -- If we already have a locked target, check if it's still valid/exists in Workspace
    if billboardLockTarget then
        if billboardLockTarget.Parent then
            -- Verify if it still contains a BillboardGui with text
            local foundValidGui = false
            for _, desc in pairs(billboardLockTarget:GetDescendants()) do
                if desc:IsA("BillboardGui") then
                    for _, textObj in pairs(desc:GetDescendants()) do
                        if (textObj:IsA("TextLabel") or textObj:IsA("TextButton")) and textObj.Text ~= "" then
                            foundValidGui = true
                            break
                        end
                    end
                end
                if foundValidGui then break end
            end
            if foundValidGui then
                return billboardLockTarget -- Keep holding this lock!
            end
        end
        -- Target expired or removed
        billboardLockTarget = nil
    end

    -- Scan workspace for parts/models containing BillboardGui with active text state
    for _, desc in pairs(Workspace:GetDescendants()) do
        if desc:IsA("BillboardGui") and desc.Enabled then
            local parentObject = desc.Parent
            if parentObject then
                for _, textObj in pairs(desc:GetDescendants()) do
                    if (textObj:IsA("TextLabel") or textObj:IsA("TextButton")) and textObj.Text ~= "" then
                        -- Check if it represents a state text
                        local textLower = string.lower(textObj.Text)
                        if string.find(textLower, "state") or string.find(textLower, "phase") or string.find(textLower, "status") or string.find(textLower, "boss") or string.find(textLower, "active") then
                            billboardLockTarget = parentObject
                            return parentObject
                        end
                    end
                end
            end
        end
    end

    return nil
end

-- STRICT REAL LETHAL HAZARD SCANNER
local function GetActiveHazardData(primaryNPCRoot)
    local _, playerRoot = GetPlayerControlInstance()
    if not playerRoot then return false, {}, Vector3.zero end
    
    local activeHazards = {}
    local netEvadeDirection = Vector3.zero
    local playerPos = playerRoot.Position

    local overlapParams = OverlapParams.new()
    overlapParams.FilterType = Enum.RaycastFilterType.Exclude
    if LocalPlayer.Character then
        overlapParams.FilterDescendantsInstances = {LocalPlayer.Character}
    end

    local parts = Workspace:GetPartBoundsInRadius(playerPos, config.scanRadius, overlapParams)
    
    for _, part in pairs(parts) do
        local isThreat = false
        local nameLower = string.lower(part.Name)
        
        if currentTarget and part:IsDescendantOf(currentTarget) then continue end

        local isExplicitWarning = string.find(nameLower, "redzone") or string.find(nameLower, "warningzone") or 
                                string.find(nameLower, "dangerzone") or string.find(nameLower, "aoe_indicator") or
                                string.find(nameLower, "explosionzone") or string.find(nameLower, "spell_aoe")

        if isExplicitWarning then isThreat = true end

        if not isThreat and part.AssemblyLinearVelocity.Magnitude > 25 then
            if string.find(nameLower, "projectile") or string.find(nameLower, "spell") or string.find(nameLower, "bullet") or string.find(nameLower, "fireball") then
                local projToPlayer = (playerPos - part.Position)
                if projToPlayer.Magnitude < 20 and part.AssemblyLinearVelocity:Dot(projToPlayer.Unit) > 0 then
                    isThreat = true
                end
            end
        end

        if not isThreat and part:FindFirstChildOfClass("TouchTransmitter") then
            if string.find(nameLower, "hitbox") or string.find(nameLower, "damage") or string.find(nameLower, "hazard") or string.find(nameLower, "attack") then
                isThreat = true
            end
        end

        if isThreat then
            local distToPlayer = (playerPos - part.Position).Magnitude
            local hazardRadius = math.max(part.Size.X, part.Size.Y, part.Size.Z) / 2
            if hazardRadius < 4 then hazardRadius = 4 end

            if distToPlayer <= (hazardRadius + 3) then
                table.insert(activeHazards, { position = part.Position, radius = hazardRadius + 2 })
                local awayVector = (playerPos - part.Position)
                if awayVector.Magnitude == 0 then awayVector = Vector3.new(math.random(-1, 1), 0, math.random(-1, 1)) end
                netEvadeDirection = netEvadeDirection + awayVector.Unit
            end
        end
    end

    allNPCs = GetAllNPCs()
    for _, npc in pairs(allNPCs) do
        if npc == currentTarget then continue end
        local npcRoot = GetNPCRoot(npc)
        if npcRoot and (npcRoot.Position - playerPos).Magnitude <= 12 then
            local busyCasting = npc:FindFirstChild("busyCasting") or npc:FindFirstChild("Casting") or npc:FindFirstChild("Attacking")
            if busyCasting and (busyCasting.Value == true or busyCasting.Value == 1) then
                table.insert(activeHazards, { position = npcRoot.Position, radius = 8 })
                local awayVector = (playerPos - npcRoot.Position)
                if awayVector.Magnitude > 0 then netEvadeDirection = netEvadeDirection + awayVector.Unit end
            end
        end
    end

    local threatDetected = #activeHazards > 0
    if threatDetected then
        if netEvadeDirection.Magnitude > 0 then netEvadeDirection = netEvadeDirection.Unit
        else netEvadeDirection = Vector3.new(1, 0, 1).Unit end
    end

    return threatDetected, activeHazards, netEvadeDirection
end

-- CALCULATE TELEPORT / OVERHEAD SAFE POSITION
local function CalculateDynamicSafePosition(npcRoot, hazards, netEvadeDir)
    local baseTargetPos = npcRoot.Position + Vector3.new(0, config.hoverHeight, 0)
    local clearBasePos = GetDirectPosition(baseTargetPos)

    local function IsPosInsideAnyHazard(pos)
        for _, hazard in ipairs(hazards) do
            local dist = (Vector3.new(pos.X, hazard.position.Y, pos.Z) - hazard.position).Magnitude
            if dist <= hazard.radius then return true end
        end
        return false
    end

    if not IsPosInsideAnyHazard(clearBasePos) then return clearBasePos, "Clear Overhead" end

    local searchRadii = {6, 10, config.maxDodgeDistance}
    local angleSteps = 8

    for _, r in ipairs(searchRadii) do
        for i = 1, angleSteps do
            local testAngle = i * (math.pi * 2 / angleSteps)
            local testPos = npcRoot.Position + Vector3.new(math.cos(testAngle) * r, config.hoverHeight, math.sin(testAngle) * r)
            local clearTestPos = GetDirectPosition(testPos)

            if not IsPosInsideAnyHazard(clearTestPos) then
                return clearTestPos, "Teleport Dodge Shift"
            end
        end
    end

    local thrustPos = clearBasePos + (netEvadeDir * config.maxDodgeDistance)
    local clearThrustPos = GetDirectPosition(thrustPos)
    if not IsPosInsideAnyHazard(clearThrustPos) then
        return clearThrustPos, "Vector Teleport"
    end

    return npcRoot.Position - Vector3.new(0, config.undergroundDepth, 0), "Subterranean Override"
end

-- Anti-Fall Engine
local function SetAntiFall(enabled)
    local humanoid, rootPart = GetPlayerControlInstance()
    
    if enabled and rootPart then
        if not floatVelocity or floatVelocity.Parent ~= rootPart then
            if floatVelocity then floatVelocity:Destroy() end
            floatVelocity = Instance.new("BodyVelocity")
            floatVelocity.Name = "AutoFarm_AntiFall"
            floatVelocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
            floatVelocity.Velocity = Vector3.zero
            floatVelocity.Parent = rootPart
        end
        if humanoid then humanoid:ChangeState(Enum.HumanoidStateType.Physics) end
        rootPart.AssemblyLinearVelocity = Vector3.zero
        rootPart.AssemblyAngularVelocity = Vector3.zero
    else
        if floatVelocity then floatVelocity:Destroy(); floatVelocity = nil end
        if humanoid then humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end
    end
end

-- Wall Noclip Loop (Always active during auto-farm)
local function SetWallNoclip(enabled)
    if enabled then
        if not noclipConnection then
            noclipConnection = RunService.Stepped:Connect(function()
                local character = LocalPlayer.Character
                if not character then return end
                for _, part in pairs(character:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
            end)
        end
    else
        if noclipConnection then noclipConnection:Disconnect(); noclipConnection = nil end
    end
end

-- Positioning Engine with Billboard State Priority
local function PositionOverhead(npcRoot)
    local _, rootPart = GetPlayerControlInstance()
    if not rootPart or not npcRoot then return end

    -- Check if a Billboard State Lock target is active
    local lockTargetInstance = FindBillboardStateLockTarget()
    if lockTargetInstance then
        local lockRoot = GetNPCRoot(lockTargetInstance) or (lockTargetInstance:IsA("BasePart") and lockTargetInstance) or lockTargetInstance.PrimaryPart
        if lockRoot then
            currentEvasionStatusText = "BILLBOARD LOCK"
            isDodging = false
            local lockPos = lockRoot.Position + Vector3.new(0, config.hoverHeight, 0)
            rootPart.CFrame = CFrame.lookAt(lockPos, lockRoot.Position)
            if floatVelocity then floatVelocity.Velocity = Vector3.zero end
            rootPart.AssemblyLinearVelocity = Vector3.zero
            rootPart.AssemblyAngularVelocity = Vector3.zero
            return
        end
    end

    local threatDetected, hazards, evadeVector = GetActiveHazardData(npcRoot)

    if threatDetected then
        isDodging = true
        local safePos, bypassType = CalculateDynamicSafePosition(npcRoot, hazards, evadeVector)
        currentEvasionStatusText = "DODGING: " .. bypassType
        rootPart.CFrame = CFrame.lookAt(safePos, npcRoot.Position)
    else
        isDodging = false
        local staticTargetPos = npcRoot.Position + Vector3.new(0, config.hoverHeight, 0)
        currentEvasionStatusText = "Safe"
        rootPart.CFrame = CFrame.lookAt(staticTargetPos, npcRoot.Position)
    end

    if floatVelocity then floatVelocity.Velocity = Vector3.zero end
    rootPart.AssemblyLinearVelocity = Vector3.zero
    rootPart.AssemblyAngularVelocity = Vector3.zero
end

-- Weapon & Skill Attack Calls
local function GetEquippedWeapon()
    local weaponEquipped = LocalPlayer:FindFirstChild("weaponEquipped")
    if not weaponEquipped or not weaponEquipped.Value or weaponEquipped.Value == "none" then return nil end
    local character = LocalPlayer.Character
    if not character then return nil end
    return character:FindFirstChild(weaponEquipped.Value)
end

local function FireWeaponSwing()
    if not spamConfig.spamSwing then return false end
    local weapon = GetEquippedWeapon()
    if weapon then
        local swing = weapon:FindFirstChild("swing", true)
        if swing and swing:IsA("RemoteEvent") then swing:FireServer(); return true end
    end
    return false
end

local function FireAbility(slot)
    if not abilityUsed then return false end
    local tool = nil
    for _, v in pairs(LocalPlayer.Backpack:GetChildren()) do
        if v:FindFirstChild("abilitySlot") and v.abilitySlot.Value == slot then tool = v break end
    end
    if not tool and LocalPlayer.Character then
        for _, v in pairs(LocalPlayer.Character:GetChildren()) do
            if v:IsA("Tool") and v:FindFirstChild("abilitySlot") and v.abilitySlot.Value == slot then tool = v break end
        end
    end
    if not tool then return false end
    local localEvent = tool:FindFirstChild("localEvent")
    if localEvent then localEvent:Fire() end
    abilityUsed:FireServer(slot, tool)
    return true
end

local function FireWeapon()
    if not LocalPlayer.Character or not weaponUsed then return false end
    local busyCasting = LocalPlayer.Character:FindFirstChild("busyCasting")
    if busyCasting and busyCasting.Value == true then return false end
    for _, v in pairs(LocalPlayer.Character:GetChildren()) do
        if v:IsA("Accessory") and v:FindFirstChild("Weapon") then
            local remoteEvent = v:FindFirstChildOfClass("RemoteEvent")
            if remoteEvent then remoteEvent:FireServer() end
            break
        end
    end
    weaponUsed:FireServer()
    return true
end

-- Spam Loop
local function StartSpam()
    local swingTimer = 0
    while isFarming do
        local humanoid, _ = GetPlayerControlInstance()
        if humanoid then
            if spamConfig.spamQ then FireAbility("q") end
            if spamConfig.spamE then FireAbility("e") end
            if spamConfig.spamWeapon then FireWeapon() end
            if spamConfig.spamSwing then
                swingTimer = swingTimer + spamConfig.delay
                if swingTimer >= spamConfig.swingDelay then FireWeaponSwing(); swingTimer = 0 end
            end
        end
        task.wait(spamConfig.delay)
    end
end

-- Camera Positioning
local function UpdateCamera()
    if not isFarming or not currentTarget then return end
    local _, rootPart = GetPlayerControlInstance()
    local npcRoot = GetNPCRoot(currentTarget)
    if rootPart and npcRoot then
        Camera.CFrame = Camera.CFrame:Lerp(CFrame.lookAt(rootPart.Position, npcRoot.Position), 0.15)
    end
end

-- Main Farming Loop
local function FarmingLoop()
    SetWallNoclip(config.wallNoclip)
    
    while isFarming do
        local humanoid, rootPart = GetPlayerControlInstance()

        if not humanoid or not rootPart then
            SetAntiFall(false)
            currentTarget = nil
            UpdateTargetHighlight(nil)
            task.wait(0.5)
            continue
        end

        SetAntiFall(true)

        if currentTarget then
            local npcRoot = GetNPCRoot(currentTarget)
            local npcHumanoid = currentTarget:FindFirstChildOfClass("Humanoid")
            PreventTargetDeath(currentTarget)
            UpdateTargetHighlight(currentTarget)

            if not npcRoot or (npcHumanoid and npcHumanoid.Health <= 0 and not config.preventTargetDeath) or not currentTarget.Parent then
                currentTarget = nil
                UpdateTargetHighlight(nil)
                task.wait(0.05)
                continue
            end

            UpdateCamera()
            PositionOverhead(npcRoot)
        else
            currentTarget = FindNearestNPC()
            UpdateTargetHighlight(currentTarget)
            if not currentTarget then task.wait(0.3); continue end
        end

        task.wait(config.checkInterval)
    end
    
    UpdateTargetHighlight(nil)
    SetAntiFall(false)
    SetWallNoclip(false)
end

-- System State Handlers
local function StartAutoFarm()
    if isFarming then return end
    isFarming = true
    currentTarget = nil
    billboardLockTarget = nil
    task.spawn(StartSpam)
    task.spawn(FarmingLoop)
end

local function StopAutoFarm()
    isFarming = false
    currentTarget = nil
    billboardLockTarget = nil
    UpdateTargetHighlight(nil)
    SetAntiFall(false)
    SetWallNoclip(false)
end

local function ToggleAutoFarm()
    if isFarming then StopAutoFarm() else StartAutoFarm() end
end

