    minFill.Parent = minSlider
    
    -- Max distance slider
    local maxLabel = Instance.new("TextLabel")
    maxLabel.Size = UDim2.new(0.45, 0, 0, 20)
    maxLabel.Position = UDim2.new(0.05, 0, 0, 275)
    maxLabel.BackgroundTransparency = 1
    maxLabel.Text = "Max Dist: " .. config.maxDistance
    maxLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    maxLabel.TextSize = 11
    maxLabel.Font = Enum.Font.Gotham
    maxLabel.Parent = frame
    
    local maxSlider = Instance.new("TextButton")
    maxSlider.Size = UDim2.new(0.4, 0, 0, 15)
    maxSlider.Position = UDim2.new(0.5, 0, 0, 275)
    maxSlider.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
    maxSlider.Text = ""
    maxSlider.Parent = frame
    
    local maxFill = Instance.new("Frame")
    maxFill.Size = UDim2.new((config.maxDistance - 10) / 40, 0, 1, 0)
    maxFill.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
    maxFill.BorderSizePixel = 0
    maxFill.Parent = maxSlider
    
    -- Slider drag handling
    local dragging = {speed = false, min = false, max = false}
    
    speedSlider.MouseButton1Down:Connect(function() dragging.speed = true end)
    speedSlider.MouseButton1Up:Connect(function() dragging.speed = false end)
    speedSlider.MouseLeave:Connect(function() dragging.speed = false end)
    
    minSlider.MouseButton1Down:Connect(function() dragging.min = true end)
    minSlider.MouseButton1Up:Connect(function() dragging.min = false end)
    minSlider.MouseLeave:Connect(function() dragging.min = false end)
    
    maxSlider.MouseButton1Down:Connect(function() dragging.max = true end)
    maxSlider.MouseButton1Up:Connect(function() dragging.max = false end)
    maxSlider.MouseLeave:Connect(function() dragging.max = false end)
    
    UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            local mouse = LocalPlayer:GetMouse()
            
            if dragging.speed then
                local pos = (mouse.X - speedSlider.AbsolutePosition.X) / speedSlider.AbsoluteSize.X
                pos = math.clamp(pos, 0, 1)
                config.moveSpeed = math.floor(5 + (pos * 45))
                speedFill.Size = UDim2.new((config.moveSpeed - 5) / 45, 0, 1, 0)
                speedLabel.Text = "Speed: " .. config.moveSpeed
            end
            
            if dragging.min then
                local pos = (mouse.X - minSlider.AbsolutePosition.X) / minSlider.AbsoluteSize.X
                pos = math.clamp(pos, 0, 1)
                config.minDistance = math.floor(5 + (pos * 25))
                if config.minDistance >= config.maxDistance then
                    config.minDistance = config.maxDistance - 2
                end
                minFill.Size = UDim2.new((config.minDistance - 5) / 25, 0, 1, 0)
                minLabel.Text = "Min Dist: " .. config.minDistance
            end
            
            if dragging.max then
                local pos = (mouse.X - maxSlider.AbsolutePosition.X) / maxSlider.AbsoluteSize.X
                pos = math.clamp(pos, 0, 1)
                config.maxDistance = math.floor(10 + (pos * 40))
                if config.maxDistance <= config.minDistance then
                    config.maxDistance = config.minDistance + 2
                end
                maxFill.Size = UDim2.new((config.maxDistance - 10) / 40, 0, 1, 0)
                maxLabel.Text = "Max Dist: " .. config.maxDistance
            end
        end
    end)
    
    -- Update status loop
    task.spawn(function()
        while true do
            -- Update health display
            local character = LocalPlayer.Character
            if character then
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                if humanoid then
                    local healthPercent = math.floor((humanoid.Health / humanoid.MaxHealth) * 100)
                    healthDisplay.Text = "❤️ Health: " .. healthPercent .. "%"
                    if healthPercent < config.hideHealthThreshold then
                        healthDisplay.TextColor3 = Color3.fromRGB(255, 50, 50)
                    elseif healthPercent < 70 then
                        healthDisplay.TextColor3 = Color3.fromRGB(255, 200, 50)
                    else
                        healthDisplay.TextColor3 = Color3.fromRGB(100, 255, 100)
                    end
                end
            end
            
            -- Get NPC count from ALL rooms
            local allNPCsList = GetAllNPCs()
            npcCount.Text = "NPCs: " .. #allNPCsList
            
            -- Get current room name
            local dungeonFolder = Workspace:FindFirstChild("dungeon")
            if dungeonFolder then
                local roomCount = 0
                local activeRooms = {}
                for _, child in pairs(dungeonFolder:GetChildren()) do
                    if child:IsA("Model") and child:FindFirstChild("enemyFolder") then
                        roomCount = roomCount + 1
                        local enemyCount = 0
                        local enemyFolder = child:FindFirstChild("enemyFolder")
                        if enemyFolder then
                            for _, npc in pairs(enemyFolder:GetChildren()) do
                                if npc:IsA("Model") then
                                    local humanoid = npc:FindFirstChildOfClass("Humanoid")
                                    if humanoid and humanoid.Health > 0 then
                                        enemyCount = enemyCount + 1
                                    end
                                end
                            end
                        end
                        if enemyCount > 0 then
                            table.insert(activeRooms, child.Name .. " (" .. enemyCount .. ")")
                        end
                    end
                end
                if #activeRooms > 0 then
                    roomDisplay.Text = "Rooms: " .. table.concat(activeRooms, ", ")
                else
                    roomDisplay.Text = "Rooms: None (cleared!)"
                end
            end
            
            local weaponEquipped = LocalPlayer:FindFirstChild("weaponEquipped")
            if weaponEquipped and weaponEquipped.Value ~= "none" then
                weaponDisplay.Text = "Weapon: " .. weaponEquipped.Value
                weaponDisplay.TextColor3 = Color3.fromRGB(100, 255, 100)
            else
                weaponDisplay.Text = "Weapon: None"
                weaponDisplay.TextColor3 = Color3.fromRGB(255, 100, 100)
            end
            
            local character = LocalPlayer.Character
            if character and currentTarget then
                local rootPart = character:FindFirstChild("HumanoidRootPart")
                local npcRoot = currentTarget:FindFirstChild("HumanoidRootPart")
                if rootPart and npcRoot then
                    local dist = (rootPart.Position - npcRoot.Position).Magnitude
                    distDisplay.Text = "Dist: " .. math.floor(dist)
                end
            end
            
            if isFarming then
                if isHiding then
                    status.Text = "🫥 HIDING (Low Health!)"
                    status.TextColor3 = Color3.fromRGB(255, 50, 50)
                elseif currentTarget then
                    local humanoid = currentTarget:FindFirstChildOfClass("Humanoid")
                    if humanoid then
                        status.Text = "Targeting: " .. string.sub(currentTarget.Name, 1, 15) .. " (" .. math.floor(humanoid.Health) .. " HP)"
                        status.TextColor3 = Color3.fromRGB(100, 255, 100)
                    end
                else
                    status.Text = "Searching for NPCs..."
                    status.TextColor3 = Color3.fromRGB(255, 255, 100)
                end
            else
                status.Text = "Status: Idle"
                status.TextColor3 = Color3.fromRGB(200, 200, 200)
            end
            
            task.wait(0.3)
        end
    end)
end

