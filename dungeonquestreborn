local originalJumpPower = 50

-- Get ALL NPCs from ALL models in dungeon
local function GetAllNPCs()
    local npcs = {}
    local dungeonFolder = Workspace:FindFirstChild("dungeon")
    if not dungeonFolder then return npcs end
    
    -- Scan ALL children in dungeon folder
    for _, model in pairs(dungeonFolder:GetChildren()) do
        if model:IsA("Model") then
            -- Check if this model has an enemyFolder
            local enemyFolder = model:FindFirstChild("enemyFolder")
            if enemyFolder then
                -- Get all NPCs in this enemyFolder
                for _, npc in pairs(enemyFolder:GetChildren()) do
                    if npc:IsA("Model") then
                        local humanoid = npc:FindFirstChildOfClass("Humanoid")
                        if humanoid and humanoid.Health > 0 then
                            table.insert(npcs, npc)
                        end
                    end
                end
            else
                -- If no enemyFolder, check if the model itself is an NPC
                local humanoid = model:FindFirstChildOfClass("Humanoid")
                if humanoid and humanoid.Health > 0 then
                    table.insert(npcs, model)
                end
            end
        end
    end
    
    return npcs
end

-- Find nearest NPC from ALL NPCs
local function FindNearestNPC()
    allNPCs = GetAllNPCs()
    if #allNPCs == 0 then return nil end
    
    local character = LocalPlayer.Character
    if not character then return nil end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return nil end
    
    local nearest = nil
    local nearestDist = math.huge
    
    for _, npc in pairs(allNPCs) do
        local npcRoot = npc:FindFirstChild("HumanoidRootPart")
        if npcRoot then
            local dist = (rootPart.Position - npcRoot.Position).Magnitude
            if dist < nearestDist then
                nearestDist = dist
                nearest = npc
            end
        end
    end
    return nearest
end

-- Get equipped weapon
local function GetEquippedWeapon()
    local weaponEquipped = LocalPlayer:FindFirstChild("weaponEquipped")
    if not weaponEquipped then return nil end
    
    local weaponName = weaponEquipped.Value
    if not weaponName or weaponName == "none" then return nil end
    
    local character = LocalPlayer.Character
    if not character then return nil end
    
    for _, child in pairs(character:GetChildren()) do
        if child:IsA("Accessory") and child.Name == weaponName then
            return child
        end
    end
    return nil
end

-- Fire weapon swing
local function FireWeaponSwing()
    if not spamConfig.spamSwing then return false end
    
    local weapon = GetEquippedWeapon()
    if not weapon then return false end
    
    local swing = weapon:FindFirstChild("swing", true)
    if swing and swing:IsA("RemoteEvent") then
        swing:FireServer()
        return true
    end
    return false
end

-- BLOX FRUIT STYLE MOVEMENT
local function MoveToPosition(targetPos)
    local character = LocalPlayer.Character
    if not character then return end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    
    humanoid.PlatformStand = true
    
    local direction = (targetPos - rootPart.Position)
    local horizontalDist = Vector3.new(direction.X, 0, direction.Z).Magnitude
    
    if horizontalDist < 1 then
        isMoving = false
        return
    end
    
    local moveDir = Vector3.new(direction.X, 0, direction.Z).Unit
    local stepSize = config.moveSpeed * 0.1
    local newPos = rootPart.Position + moveDir * stepSize
    
    -- Face target
    local lookAt = CFrame.new(rootPart.Position, targetPos)
    rootPart.CFrame = CFrame.new(newPos, Vector3.new(
        lookAt.LookVector.X,
        0,
        lookAt.LookVector.Z
    ))
    
    isMoving = true
end

-- Stop moving
local function StopMoving()
    isMoving = false
    local character = LocalPlayer.Character
    if character then
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.PlatformStand = false
        end
    end
end

-- Movement loop
local function MovementLoop()
    while isFarming do
        if isMoving and targetPosition then
            MoveToPosition(targetPosition)
        end
        task.wait(0.05)
    end
end

-- Fire ability
local function FireAbility(slot)
    local tool = nil
    
    for _, v in pairs(LocalPlayer.Backpack:GetChildren()) do
        if v:FindFirstChild("abilitySlot") and v.abilitySlot.Value == slot then
            tool = v
            break
        end
    end
    
    if not tool and LocalPlayer.Character then
        for _, v in pairs(LocalPlayer.Character:GetChildren()) do
            if v:IsA("Tool") and v:FindFirstChild("abilitySlot") and v.abilitySlot.Value == slot then
                tool = v
                break
            end
        end
    end
    
    if not tool then return false end
    
    local localEvent = tool:FindFirstChild("localEvent")
    if localEvent then
        localEvent:Fire()
    end
    
    abilityUsed:FireServer(slot, tool)
    return true
end

-- Fire weapon
local function FireWeapon()
    if not LocalPlayer.Character then return false end
    
    local busyCasting = LocalPlayer.Character:FindFirstChild("busyCasting")
    if busyCasting and busyCasting.Value == true then return false end
    
    local weapon = nil
    for _, v in pairs(LocalPlayer.Character:GetChildren()) do
        if v:IsA("Accessory") and v:FindFirstChild("Weapon") then
            weapon = v
            break
        end
    end
    
    if not weapon then return false end
    
    local remoteEvent = weapon:FindFirstChildOfClass("RemoteEvent")
    if remoteEvent then
        remoteEvent:FireServer()
    end
    
    weaponUsed:FireServer()
    return true
end

-- Spam loop
local function StartSpam()
    local swingTimer = 0
    
    while isFarming do
        if spamConfig.spamQ then
            FireAbility("q")
        end
        
        if spamConfig.spamE then
            FireAbility("e")
        end
        
        if spamConfig.spamWeapon then
            FireWeapon()
        end
        
        if spamConfig.spamSwing then
            swingTimer = swingTimer + spamConfig.delay
            if swingTimer >= spamConfig.swingDelay then
                FireWeaponSwing()
                swingTimer = 0
            end
        end
        
        task.wait(spamConfig.delay)
    end
end

-- Camera tracking function
local function UpdateCamera()
    if not isFarming or not currentTarget then return end
    
    local character = LocalPlayer.Character
    if not character then return end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    local npcRoot = currentTarget:FindFirstChild("HumanoidRootPart")
    
    if rootPart and npcRoot then
        -- Calculate position slightly above target for better view
        local targetPos = npcRoot.Position + Vector3.new(0, 5, 0)
        local currentPos = rootPart.Position + Vector3.new(0, 2, 0)
        
        -- Smooth camera movement
        local newCFrame = CFrame.new(currentPos, targetPos)
        Camera.CFrame = Camera.CFrame:Lerp(newCFrame, 0.2)
    end
end

-- Health check and hide function
local function CheckHealthAndHide()
    local character = LocalPlayer.Character
    if not character then return end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    
    local health = humanoid.Health
    local maxHealth = humanoid.MaxHealth
    
    -- Check if we should hide
    if health < config.hideHealthThreshold and not isHiding then
        isHiding = true
        print("🫥 Health below " .. config.hideHealthThreshold .. "! Hiding...")
        
        -- Make character invisible
        for _, part in pairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.Transparency = 1
                part.CanCollide = false
            end
        end
        
        -- Disable movement
        humanoid.WalkSpeed = 0
        humanoid.JumpPower = 0
        
        -- Stop moving
        StopMoving()
        targetPosition = nil
        
        -- Stop attacking
        spamConfig.spamQ = false
        spamConfig.spamE = false
        spamConfig.spamWeapon = false
        spamConfig.spamSwing = false
        
    elseif health >= config.unhideHealthThreshold and isHiding then
        isHiding = false
        print("🫡 Health reached " .. config.unhideHealthThreshold .. "! Unhiding...")
        
        -- Make character visible
        for _, part in pairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.Transparency = 0
                part.CanCollide = true
            end
        end
        
        -- Restore movement
        humanoid.WalkSpeed = originalWalkspeed
        humanoid.JumpPower = originalJumpPower
        
        -- Restore attacking
        spamConfig.spamQ = true
        spamConfig.spamE = true
        spamConfig.spamWeapon = true
        spamConfig.spamSwing = true
    end
end

-- Main farming loop - SCANS ALL MODELS IN DUNGEON
local function FarmingLoop()
    while isFarming do
        -- Check health and handle hiding
        CheckHealthAndHide()
        
        -- If hiding, just wait
        if isHiding then
            task.wait(1)
            continue
        end
        
        local character = LocalPlayer.Character
        if not character then
            StopMoving()
            task.wait(1)
            continue
        end
        
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then
            StopMoving()
            task.wait(1)
            continue
        end
        
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        if not rootPart then
            task.wait(1)
            continue
        end
        
        -- Check if current target still exists and has health
        if currentTarget then
            local npcHumanoid = currentTarget:FindFirstChildOfClass("Humanoid")
            if not npcHumanoid or npcHumanoid.Health <= 0 then
                -- Target is dead, find new one from ALL NPCs
                currentTarget = nil
                StopMoving()
                targetPosition = nil
                task.wait(0.1)
                continue
            end
            
            local npcRoot = currentTarget:FindFirstChild("HumanoidRootPart")
            if not npcRoot then
                -- Target invalid, find new one
                currentTarget = nil
                StopMoving()
                targetPosition = nil
                task.wait(0.1)
                continue
            end
            
            -- Update camera to track target
            UpdateCamera()
            
            -- Calculate horizontal distance
            local horizontalDist = Vector3.new(
                rootPart.Position.X - npcRoot.Position.X,
                0,
                rootPart.Position.Z - npcRoot.Position.Z
            ).Magnitude
            
            local targetPos = npcRoot.Position
            
            -- Maintain safe distance
            if horizontalDist < config.minDistance then
                -- Too close, back up
                local away = (rootPart.Position - targetPos)
                away = Vector3.new(away.X, 0, away.Z).Unit
                targetPosition = targetPos + away * config.minDistance
                isMoving = true
                
            elseif horizontalDist > config.maxDistance then
                -- Too far, move closer
                local towards = (targetPos - rootPart.Position)
                towards = Vector3.new(towards.X, 0, towards.Z).Unit
                targetPosition = targetPos - towards * config.maxDistance
                isMoving = true
            else
                -- In range, stop moving
                StopMoving()
                targetPosition = nil
                
                -- Face target
                local lookAt = CFrame.new(rootPart.Position, targetPos)
                rootPart.CFrame = CFrame.new(rootPart.Position, Vector3.new(
                    lookAt.LookVector.X,
                    0,
                    lookAt.LookVector.Z
                ))
            end
            
        else
            -- Find nearest NPC from ALL NPCs (scans all models in dungeon)
            currentTarget = FindNearestNPC()
            
            if not currentTarget then
                -- No NPCs found anywhere, wait and check again
                StopMoving()
                targetPosition = nil
                task.wait(1)
                continue
            end
            
            -- Found an NPC, move to it
            local npcRoot = currentTarget:FindFirstChild("HumanoidRootPart")
            if npcRoot then
                local targetPos = npcRoot.Position
                local horizontalDist = Vector3.new(
                    rootPart.Position.X - targetPos.X,
                    0,
                    rootPart.Position.Z - targetPos.Z
                ).Magnitude
                
                if horizontalDist > config.maxDistance then
                    local towards = (targetPos - rootPart.Position)
                    towards = Vector3.new(towards.X, 0, towards.Z).Unit
                    targetPosition = targetPos - towards * config.maxDistance
                    isMoving = true
                end
            end
        end
        
        task.wait(config.checkInterval)
    end
    
    StopMoving()
    targetPosition = nil
end

-- Start auto-farm
local function StartAutoFarm()
    if isFarming then return end
    
    isFarming = true
    currentTarget = nil
    targetPosition = nil
    allNPCs = {}
    isHiding = false
    
    -- Save original movement values
    local character = LocalPlayer.Character
    if character then
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            originalWalkspeed = humanoid.WalkSpeed
            originalJumpPower = humanoid.JumpPower
        end
    end
    
    print("🌾 Auto-Farm STARTED!")
    print("🔪 Weapon swing spam: " .. (spamConfig.spamSwing and "ON" or "OFF"))
    print("📊 Scanning ALL models in dungeon for NPCs")
    print("❤️ Auto-hide when health < " .. config.hideHealthThreshold)
    print("📷 Camera will track targets")
    
    moveThread = task.spawn(MovementLoop)
    spamThread = task.spawn(StartSpam)
    autoFarmThread = task.spawn(FarmingLoop)
end

-- Stop auto-farm
local function StopAutoFarm()
    isFarming = false
    currentTarget = nil
    targetPosition = nil
    allNPCs = {}
    
    -- Unhide if hiding
    if isHiding then
        local character = LocalPlayer.Character
        if character then
            for _, part in pairs(character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.Transparency = 0
                    part.CanCollide = true
                end
            end
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            if humanoid then
                humanoid.WalkSpeed = originalWalkspeed
                humanoid.JumpPower = originalJumpPower
            end
        end
        isHiding = false
    end
    
    StopMoving()
    
    if moveThread then
        task.cancel(moveThread)
        moveThread = nil
    end
    
    if spamThread then
        task.cancel(spamThread)
        spamThread = nil
    end
    
    if autoFarmThread then
        task.cancel(autoFarmThread)
        autoFarmThread = nil
    end
    
    print("⏹️ Auto-Farm STOPPED")
end

-- Toggle auto-farm
local function ToggleAutoFarm()
    if isFarming then
        StopAutoFarm()
    else
        StartAutoFarm()
    end
end

