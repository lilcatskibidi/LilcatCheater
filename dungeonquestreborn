            local allNPCsList = GetAllNPCs()
            npcCount.Text = "NPCs: " .. #allNPCsList
            
            local dungeonFolder = Workspace:FindFirstChild("dungeon")
            if dungeonFolder then
                local activeRooms = {}
                for _, child in pairs(dungeonFolder:GetChildren()) do
                    if child:IsA("Model") and child:FindFirstChild("enemyFolder") then
                        local enemyCount = 0
                        local enemyFolder = child:FindFirstChild("enemyFolder")
                        if enemyFolder then
                            for _, npc in pairs(enemyFolder:GetChildren()) do
                                if npc:IsA("Model") then
                                    local humanoid = npc:FindFirstChildOfClass("Humanoid")
                                    if humanoid and humanoid.Health > 0 then
                                        enemyCount = enemyCount + 1
                                    end
                                end
                            end
                        end
                        if enemyCount > 0 then
                            table.insert(activeRooms, child.Name .. " (" .. enemyCount .. ")")
                        end
                    end
                end
                if #activeRooms > 0 then
                    roomDisplay.Text = "Rooms: " .. table.concat(activeRooms, ", ")
                else
                    roomDisplay.Text = "Rooms: None (cleared!)"
                end
            end
            
            local weaponEquipped = LocalPlayer:FindFirstChild("weaponEquipped")
            if weaponEquipped and weaponEquipped.Value ~= "none" then
                weaponDisplay.Text = "Weapon: " .. weaponEquipped.Value
                weaponDisplay.TextColor3 = Color3.fromRGB(100, 255, 100)
            else
                weaponDisplay.Text = "Weapon: None"
                weaponDisplay.TextColor3 = Color3.fromRGB(255, 100, 100)
            end
            
            local character = LocalPlayer.Character
            if character and currentTarget then
                local rootPart = GetCharacterRoot()
                local npcRoot = GetNPCRoot(currentTarget)
                if rootPart and npcRoot then
                    local dist = (rootPart.Position - npcRoot.Position).Magnitude
                    distDisplay.Text = "Dist: " .. math.floor(dist)
                end
            end
            
            if isFarming then
                if currentTarget then
                    local humanoid = currentTarget:FindFirstChildOfClass("Humanoid")
                    if humanoid then
                        status.Text = "🌀 Orbiting: " .. string.sub(currentTarget.Name, 1, 12) .. " (" .. math.floor(humanoid.Health) .. " HP)"
                        status.TextColor3 = Color3.fromRGB(100, 255, 100)
                    end
                else
                    status.Text = "Searching for NPCs..."
                    status.TextColor3 = Color3.fromRGB(255, 255, 100)
                end
            else
                status.Text = "Status: Idle"
                status.TextColor3 = Color3.fromRGB(200, 200, 200)
            end
            
            task.wait(0.3)
        end
    end)
end

