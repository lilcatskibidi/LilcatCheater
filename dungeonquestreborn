    dodgeStatus.TextColor3 = Color3.fromRGB(100, 200, 255)
    dodgeStatus.Font = Enum.Font.Gotham
    dodgeStatus.TextSize = 12
    dodgeStatus.Parent = frame

    local npcCount = Instance.new("TextLabel")
    npcCount.Size = UDim2.new(0.9, 0, 0, 25)
    npcCount.Position = UDim2.new(0.05, 0, 0, 130)
    npcCount.BackgroundTransparency = 1
    npcCount.Text = "Target NPCs: 0"
    npcCount.TextColor3 = Color3.fromRGB(180, 180, 180)
    npcCount.Font = Enum.Font.Gotham
    npcCount.TextSize = 12
