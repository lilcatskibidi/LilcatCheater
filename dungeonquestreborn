--[[
    AUTO-FARM SYSTEM - TWEEN SMOOTHING & EVADER EDITION
    - Lerp Smoothing: Uses frame-rate independent CFrame:Lerp for fluid Tween-like movement
    - Dynamic Threat Evader: Smoothly glides away when skill/hitbox markers are detected
    - Physics Anti-Fall: AssemblyLinearVelocity nulling + Physics state override
    - Fully Retained: UI mounted to CoreGui, auto remote triggers, keybinds, full paste-in
]]

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")
local Camera = Workspace.CurrentCamera

-- Get Remotes with protection
local remotes = ReplicatedStorage:FindFirstChild("remotes")
local abilityUsed = remotes and remotes:FindFirstChild("abilityUsed")
local weaponUsed = remotes and remotes:FindFirstChild("weaponUsed")
local changeStartValue = remotes and remotes:FindFirstChild("changeStartValue")

-- Auto-farm configuration
local config = {
    hoverHeight = 9,       -- Default hover height above NPC
    orbitRadius = 4,       -- Base tight orbit radius
    checkInterval = 0.03,
    moveSpeed = 120,
    rotationSpeed = 3.5,   -- Smooth orbital rotation speed
    smoothness = 0.18,     -- Lerp factor (0.05 = super smooth/slow, 0.3 = fast tween)
    wallNoclip = true,
    
    -- Evasion Settings
    scanRadius = 25,       -- Detection range around NPC for skills/projectiles
    dodgeDistance = 12,    -- Distance to glide away when dynamic skill detected
}

-- Spam configuration
local spamConfig = {
    spamQ = true,
    spamE = true,
    spamWeapon = true,
    spamSwing = true,
    delay = 0.02,
    swingDelay = 0.05,
}

-- State variables
local currentTarget = nil
local isFarming = false
local allNPCs = {}
local angle = 0
local noclipConnection = nil
local floatVelocity = nil
local isDodging = false
local dodgeOffset = Vector3.zero

-- Safe Character & Root Instance Detection
local function GetPlayerControlInstance()
    local character = LocalPlayer.Character
    if not character or not character.Parent then return nil, nil end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local rootPart = character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart

    if not humanoid or humanoid.Health <= 0 then return nil, nil end

    if not rootPart then
        for _, child in pairs(character:GetChildren()) do
            if child:IsA("BasePart") and child.Name ~= "Head" then
                rootPart = child
                break
            end
        end
    end

    return humanoid, rootPart
end

-- NPC Root Target Finder
local function GetNPCRoot(npc)
    if not npc or not npc:IsA("Model") or not npc.Parent then return nil end
    return npc:FindFirstChild("HumanoidRootPart") or npc.PrimaryPart or npc:FindFirstChildOfClass("BasePart")
end

-- NPC Search
local function GetAllNPCs()
    local npcs = {}
    
    local function CheckModel(model)
        if not model:IsA("Model") or model == LocalPlayer.Character then return end
        if Players:GetPlayerFromCharacter(model) then return end
        
        local humanoid = model:FindFirstChildOfClass("Humanoid") or model:FindFirstChildOfClass("AnimationController")
        local root = GetNPCRoot(model)
        
        if root then
            if humanoid and humanoid:IsA("Humanoid") then
                if humanoid.Health > 0 then
                    table.insert(npcs, model)
                end
            else
                local healthVal = model:FindFirstChild("Health") or model:FindFirstChild("HP")
                if healthVal and healthVal:IsA("ValueBase") and healthVal.Value > 0 then
                    table.insert(npcs, model)
                end
            end
        end
    end

    local dungeonFolder = Workspace:FindFirstChild("dungeon") or Workspace:FindFirstChild("Dungeon")
    if dungeonFolder then
        for _, desc in pairs(dungeonFolder:GetDescendants()) do
            if desc:IsA("Model") then
                CheckModel(desc)
            end
        end
    else
        for _, child in pairs(Workspace:GetChildren()) do
            if child:IsA("Model") then
                CheckModel(child)
            end
        end
    end

    return npcs
end

-- Nearest Target Detector
local function FindNearestNPC()
    allNPCs = GetAllNPCs()
    if #allNPCs == 0 then return nil end

    local _, rootPart = GetPlayerControlInstance()
    if not rootPart then return nil end

    local nearest = nil
    local nearestDist = math.huge

    for _, npc in pairs(allNPCs) do
        local npcRoot = GetNPCRoot(npc)
        if npcRoot then
            local dist = (rootPart.Position - npcRoot.Position).Magnitude
            if dist < nearestDist then
                nearestDist = dist
                nearest = npc
            end
        end
    end
    return nearest
end

-- Dynamic Skill / Threat Detector
local function DetectIncomingThreat(npcRoot)
    if not npcRoot then return false, Vector3.zero end
    
    local threatFound = false
    local evadeDirection = Vector3.zero
    local center = npcRoot.Position

    local overlapParams = OverlapParams.new()
    overlapParams.FilterType = Enum.RaycastFilterType.Exclude
    if LocalPlayer.Character then
        overlapParams.FilterDescendantsInstances = {LocalPlayer.Character, currentTarget}
    end

    local parts = Workspace:GetPartBoundsInRadius(center, config.scanRadius, overlapParams)
    
    for _, part in pairs(parts) do
        local nameLower = string.lower(part.Name)
        
        local isWarningZone = string.find(nameLower, "redzone") or string.find(nameLower, "hitbox") or 
                               string.find(nameLower, "aoe") or string.find(nameLower, "warning") or 
                               string.find(nameLower, "skill") or string.find(nameLower, "indicator")
        
        local hasParticle = part:FindFirstChildOfClass("ParticleEmitter") ~= nil
        local isProjectile = part.AssemblyLinearVelocity.Magnitude > 25

        if isWarningZone or isProjectile or (hasParticle and part.Size.Magnitude > 6) then
            threatFound = true
            local partPos = part.Position
            local awayVector = (center - partPos)
            if awayVector.Magnitude == 0 then
                awayVector = Vector3.new(math.random(-1, 1), 0, math.random(-1, 1))
            end
            evadeDirection = evadeDirection + awayVector.Unit
        end
    end

    if threatFound then
        if evadeDirection.Magnitude > 0 then
            evadeDirection = evadeDirection.Unit
        else
            evadeDirection = Vector3.new(1, 0, 1).Unit
        end
    end

    return threatFound, evadeDirection
end

-- Anti-Fall Engine
local function SetAntiFall(enabled)
    local humanoid, rootPart = GetPlayerControlInstance()
    
    if enabled and rootPart then
        if not floatVelocity or floatVelocity.Parent ~= rootPart then
            if floatVelocity then floatVelocity:Destroy() end
            floatVelocity = Instance.new("BodyVelocity")
            floatVelocity.Name = "AutoFarm_AntiFall"
            floatVelocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
            floatVelocity.Velocity = Vector3.zero
            floatVelocity.Parent = rootPart
        end
        if humanoid then
            humanoid:ChangeState(Enum.HumanoidStateType.Physics)
        end
        rootPart.AssemblyLinearVelocity = Vector3.zero
        rootPart.AssemblyAngularVelocity = Vector3.zero
    else
        if floatVelocity then
            floatVelocity:Destroy()
            floatVelocity = nil
        end
        if humanoid then
            humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
    end
end

-- Wall Noclip Loop
local function SetWallNoclip(enabled)
    if enabled then
        if not noclipConnection then
            noclipConnection = RunService.Stepped:Connect(function()
                local character = LocalPlayer.Character
                if not character then return end
                
                for _, part in pairs(character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end)
        end
    else
        if noclipConnection then
            noclipConnection:Disconnect()
            noclipConnection = nil
        end
    end
end

-- Smooth Tween-Like Overhead Positioning & Dynamic Dodge Evader
local function PositionOverhead(npcRoot)
    local humanoid, rootPart = GetPlayerControlInstance()
    if not rootPart or not npcRoot then return end

    local threatDetected, evadeVector = DetectIncomingThreat(npcRoot)
    isDodging = threatDetected

    angle = angle + (config.rotationSpeed * config.checkInterval)
    local radius = config.orbitRadius
    
    if isDodging then
        radius = config.orbitRadius + config.dodgeDistance
        dodgeOffset = dodgeOffset:Lerp(evadeVector * config.dodgeDistance, 0.15)
    else
        dodgeOffset = dodgeOffset:Lerp(Vector3.zero, 0.1)
    end

    local offsetX = math.cos(angle) * radius
    local offsetZ = math.sin(angle) * radius
    
    local targetPos = npcRoot.Position + Vector3.new(offsetX, config.hoverHeight, offsetZ) + dodgeOffset
    local lookTarget = npcRoot.Position

    -- Smooth CFrame Lerp Interpolation (Creates the smooth Tween movement effect)
    local desiredCFrame = CFrame.lookAt(targetPos, lookTarget)
    rootPart.CFrame = rootPart.CFrame:Lerp(desiredCFrame, config.smoothness)
    
    if floatVelocity then
        floatVelocity.Velocity = Vector3.zero
    end
    
    rootPart.AssemblyLinearVelocity = Vector3.zero
    rootPart.AssemblyAngularVelocity = Vector3.zero
end

-- Weapon & Skill Attack Calls
local function GetEquippedWeapon()
    local weaponEquipped = LocalPlayer:FindFirstChild("weaponEquipped")
    if not weaponEquipped or not weaponEquipped.Value or weaponEquipped.Value == "none" then return nil end
    local character = LocalPlayer.Character
    if not character then return nil end
    return character:FindFirstChild(weaponEquipped.Value)
end

local function FireWeaponSwing()
    if not spamConfig.spamSwing then return false end
    local weapon = GetEquippedWeapon()
    if weapon then
        local swing = weapon:FindFirstChild("swing", true)
        if swing and swing:IsA("RemoteEvent") then
            swing:FireServer()
            return true
        end
    end
    return false
end

local function FireAbility(slot)
    if not abilityUsed then return false end
    local tool = nil
    for _, v in pairs(LocalPlayer.Backpack:GetChildren()) do
        if v:FindFirstChild("abilitySlot") and v.abilitySlot.Value == slot then tool = v break end
    end
    if not tool and LocalPlayer.Character then
        for _, v in pairs(LocalPlayer.Character:GetChildren()) do
            if v:IsA("Tool") and v:FindFirstChild("abilitySlot") and v.abilitySlot.Value == slot then tool = v break end
        end
    end
    if not tool then return false end
    local localEvent = tool:FindFirstChild("localEvent")
    if localEvent then localEvent:Fire() end
    abilityUsed:FireServer(slot, tool)
    return true
end

local function FireWeapon()
    if not LocalPlayer.Character or not weaponUsed then return false end
    local busyCasting = LocalPlayer.Character:FindFirstChild("busyCasting")
    if busyCasting and busyCasting.Value == true then return false end
    
    for _, v in pairs(LocalPlayer.Character:GetChildren()) do
        if v:IsA("Accessory") and v:FindFirstChild("Weapon") then
            local remoteEvent = v:FindFirstChildOfClass("RemoteEvent")
            if remoteEvent then remoteEvent:FireServer() end
            break
        end
    end
    weaponUsed:FireServer()
    return true
end

-- Spam Loop
local function StartSpam()
    local swingTimer = 0
    while isFarming do
        local humanoid, _ = GetPlayerControlInstance()
        if humanoid then
            if spamConfig.spamQ then FireAbility("q") end
            if spamConfig.spamE then FireAbility("e") end
            if spamConfig.spamWeapon then FireWeapon() end
            if spamConfig.spamSwing then
                swingTimer = swingTimer + spamConfig.delay
                if swingTimer >= spamConfig.swingDelay then
                    FireWeaponSwing()
                    swingTimer = 0
                end
            end
        end
        task.wait(spamConfig.delay)
    end
end

-- Camera Positioning
local function UpdateCamera()
    if not isFarming or not currentTarget then return end
    local _, rootPart = GetPlayerControlInstance()
    local npcRoot = GetNPCRoot(currentTarget)
    if rootPart and npcRoot then
        local targetPos = npcRoot.Position
        local currentPos = rootPart.Position
        Camera.CFrame = Camera.CFrame:Lerp(CFrame.lookAt(currentPos, targetPos), 0.15)
    end
end

-- Main Farming Loop
local function FarmingLoop()
    SetWallNoclip(config.wallNoclip)
    
    while isFarming do
        local humanoid, rootPart = GetPlayerControlInstance()

        if not humanoid or not rootPart then
            SetAntiFall(false)
            currentTarget = nil
            task.wait(0.5)
            continue
        end

        SetAntiFall(true)

        if currentTarget then
            local npcRoot = GetNPCRoot(currentTarget)
            local npcHumanoid = currentTarget:FindFirstChildOfClass("Humanoid")
            
            if not npcRoot or (npcHumanoid and npcHumanoid.Health <= 0) or not currentTarget.Parent then
                currentTarget = nil
                task.wait(0.05)
                continue
            end

            UpdateCamera()
            PositionOverhead(npcRoot)
        else
            currentTarget = FindNearestNPC()
            if not currentTarget then
                task.wait(0.3)
                continue
            end
        end

        task.wait(config.checkInterval)
    end
    
    SetAntiFall(false)
    SetWallNoclip(false)
end

-- System State Handlers
local function StartAutoFarm()
    if isFarming then return end
    isFarming = true
    currentTarget = nil
    angle = 0
    task.spawn(StartSpam)
    task.spawn(FarmingLoop)
end

local function StopAutoFarm()
    isFarming = false
    currentTarget = nil
    SetAntiFall(false)
    SetWallNoclip(false)
end

local function ToggleAutoFarm()
    if isFarming then StopAutoFarm() else StartAutoFarm() end
end

-- Respawn & Character Removal Connections
LocalPlayer.CharacterAdded:Connect(function(newChar)
    if isFarming then
        SetAntiFall(false)
        newChar:WaitForChild("Humanoid", 10)
        newChar:WaitForChild("HumanoidRootPart", 10)
        task.wait(0.5)
        if isFarming then
            SetAntiFall(true)
        end
    end
end)

