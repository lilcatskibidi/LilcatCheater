    hitboxFill.Size = UDim2.new((config.hitboxSize - 5) / 45, 0, 1, 0)
    hitboxFill.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
    hitboxFill.BorderSizePixel = 0
    hitboxFill.Parent = hitboxSlider
    
    -- Orbit radius slider
    local orbitLabel = Instance.new("TextLabel")
    orbitLabel.Size = UDim2.new(0.45, 0, 0, 20)
    orbitLabel.Position = UDim2.new(0.05, 0, 0, 230)
    orbitLabel.BackgroundTransparency = 1
    orbitLabel.Text = "Orbit: " .. config.orbitRadius
    orbitLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    orbitLabel.TextSize = 11
    orbitLabel.Font = Enum.Font.Gotham
    orbitLabel.Parent = frame
    
    local orbitSlider = Instance.new("TextButton")
    orbitSlider.Size = UDim2.new(0.4, 0, 0, 15)
    orbitSlider.Position = UDim2.new(0.5, 0, 0, 230)
    orbitSlider.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
    orbitSlider.Text = ""
    orbitSlider.Parent = frame
    
    local orbitFill = Instance.new("Frame")
    orbitFill.Size = UDim2.new((config.orbitRadius - 5) / 25, 0, 1, 0)
    orbitFill.BackgroundColor3 = Color3.fromRGB(0, 200, 255)
    orbitFill.BorderSizePixel = 0
    orbitFill.Parent = orbitSlider
    
    -- Speed slider
    local speedLabel = Instance.new("TextLabel")
    speedLabel.Size = UDim2.new(0.45, 0, 0, 20)
    speedLabel.Position = UDim2.new(0.05, 0, 0, 255)
    speedLabel.BackgroundTransparency = 1
    speedLabel.Text = "Speed: " .. config.moveSpeed
    speedLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    speedLabel.TextSize = 11
    speedLabel.Font = Enum.Font.Gotham
    speedLabel.Parent = frame
    
    local speedSlider = Instance.new("TextButton")
    speedSlider.Size = UDim2.new(0.4, 0, 0, 15)
    speedSlider.Position = UDim2.new(0.5, 0, 0, 255)
    speedSlider.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
    speedSlider.Text = ""
    speedSlider.Parent = frame
    
    local speedFill = Instance.new("Frame")
    speedFill.Size = UDim2.new((config.moveSpeed - 30) / 100, 0, 1, 0)
    speedFill.BackgroundColor3 = Color3.fromRGB(255, 100, 100)
    speedFill.BorderSizePixel = 0
    speedFill.Parent = speedSlider
    
    -- Slider dragging
    local dragging = {hitbox = false, orbit = false, speed = false}
    
    hitboxSlider.MouseButton1Down:Connect(function() dragging.hitbox = true end)
    hitboxSlider.MouseButton1Up:Connect(function() dragging.hitbox = false end)
    hitboxSlider.MouseLeave:Connect(function() dragging.hitbox = false end)
    
    orbitSlider.MouseButton1Down:Connect(function() dragging.orbit = true end)
    orbitSlider.MouseButton1Up:Connect(function() dragging.orbit = false end)
    orbitSlider.MouseLeave:Connect(function() dragging.orbit = false end)
    
    speedSlider.MouseButton1Down:Connect(function() dragging.speed = true end)
    speedSlider.MouseButton1Up:Connect(function() dragging.speed = false end)
    speedSlider.MouseLeave:Connect(function() dragging.speed = false end)
    
    UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            local mouse = LocalPlayer:GetMouse()
            
            if dragging.hitbox then
                local pos = (mouse.X - hitboxSlider.AbsolutePosition.X) / hitboxSlider.AbsoluteSize.X
                pos = math.clamp(pos, 0, 1)
                config.hitboxSize = math.floor(5 + (pos * 45))
                hitboxFill.Size = UDim2.new((config.hitboxSize - 5) / 45, 0, 1, 0)
                hitboxLabel.Text = "Hitbox: " .. config.hitboxSize
                -- Update existing hitboxes with new size
                CleanupHitboxes()
                ExpandAllHitboxes()
            end
            
            if dragging.orbit then
                local pos = (mouse.X - orbitSlider.AbsolutePosition.X) / orbitSlider.AbsoluteSize.X
                pos = math.clamp(pos, 0, 1)
                config.orbitRadius = math.floor(5 + (pos * 25))
                orbitFill.Size = UDim2.new((config.orbitRadius - 5) / 25, 0, 1, 0)
                orbitLabel.Text = "Orbit: " .. config.orbitRadius
            end
            
            if dragging.speed then
                local pos = (mouse.X - speedSlider.AbsolutePosition.X) / speedSlider.AbsoluteSize.X
                pos = math.clamp(pos, 0, 1)
                config.moveSpeed = math.floor(30 + (pos * 100))
                speedFill.Size = UDim2.new((config.moveSpeed - 30) / 100, 0, 1, 0)
                speedLabel.Text = "Speed: " .. config.moveSpeed
            end
        end
    end)
    
    -- Status update loop
    task.spawn(function()
        while true do
            local allNPCsList = GetAllNPCs()
            npcCount.Text = "NPCs: " .. #allNPCsList
            
            local dungeonFolder = Workspace:FindFirstChild("dungeon")
            if dungeonFolder then
                local activeRooms = {}
                for _, child in pairs(dungeonFolder:GetChildren()) do
                    if child:IsA("Model") and child:FindFirstChild("enemyFolder") then
                        local enemyCount = 0
                        local enemyFolder = child:FindFirstChild("enemyFolder")
                        if enemyFolder then
                            for _, npc in pairs(enemyFolder:GetChildren()) do
                                if npc:IsA("Model") then
                                    local humanoid = npc:FindFirstChildOfClass("Humanoid")
                                    if humanoid and humanoid.Health > 0 then
                                        enemyCount = enemyCount + 1
                                    end
                                end
                            end
                        end
                        if enemyCount > 0 then
                            table.insert(activeRooms, child.Name .. " (" .. enemyCount .. ")")
                        end
                    end
                end
                if #activeRooms > 0 then
                    roomDisplay.Text = "Rooms: " .. table.concat(activeRooms, ", ")
                else
                    roomDisplay.Text = "Rooms: None (cleared!)"
                end
            end
            
            local weaponEquipped = LocalPlayer:FindFirstChild("weaponEquipped")
            if weaponEquipped and weaponEquipped.Value ~= "none" then
                weaponDisplay.Text = "Weapon: " .. weaponEquipped.Value
                weaponDisplay.TextColor3 = Color3.fromRGB(100, 255, 100)
            else
                weaponDisplay.Text = "Weapon: None"
                weaponDisplay.TextColor3 = Color3.fromRGB(255, 100, 100)
            end
            
            local character = LocalPlayer.Character
            if character and currentTarget then
                local rootPart = GetCharacterRoot()
                local npcRoot = GetNPCRoot(currentTarget)
                if rootPart and npcRoot then
                    local dist = (rootPart.Position - npcRoot.Position).Magnitude
                    distDisplay.Text = "Dist: " .. math.floor(dist)
                end
            end
            
            if isFarming then
                if currentTarget then
                    local humanoid = currentTarget:FindFirstChildOfClass("Humanoid")
                    if humanoid then
                        status.Text = "🌀 Orbiting: " .. string.sub(currentTarget.Name, 1, 12) .. " (" .. math.floor(humanoid.Health) .. " HP)"
                        status.TextColor3 = Color3.fromRGB(100, 255, 100)
                    end
                else
                    status.Text = "Searching for NPCs..."
                    status.TextColor3 = Color3.fromRGB(255, 255, 100)
                end
            else
                status.Text = "Status: Idle"
                status.TextColor3 = Color3.fromRGB(200, 200, 200)
            end
            
            task.wait(0.3)
        end
    end)
end

