-- Safe Character & Root Instance Detection
local function GetPlayerControlInstance()
    local character = LocalPlayer.Character
    if not character or not character.Parent then return nil, nil end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local rootPart = character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart

    if not humanoid or humanoid.Health <= 0 then return nil, nil end

    if not rootPart then
        for _, child in pairs(character:GetChildren()) do
            if child:IsA("BasePart") and child.Name ~= "Head" then
                rootPart = child
                break
            end
        end
    end

    return humanoid, rootPart
end

-- NPC Root Target Finder
local function GetNPCRoot(npc)
    if not npc or not npc:IsA("Model") or not npc.Parent then return nil end
    return npc:FindFirstChild("HumanoidRootPart") or npc.PrimaryPart or npc:FindFirstChildOfClass("BasePart")
end

-- Target Highlight Management
local function UpdateTargetHighlight(npc)
    if not npc or not npc.Parent then
        if targetHighlight then
            targetHighlight:Destroy()
            targetHighlight = nil
        end
        return
    end

    if not targetHighlight or targetHighlight.Parent ~= npc then
        if targetHighlight then targetHighlight:Destroy() end
        targetHighlight = Instance.new("Highlight")
        targetHighlight.Name = "AutoFarm_TargetHighlight"
        targetHighlight.FillColor = Color3.fromRGB(255, 50, 50)
        targetHighlight.OutlineColor = Color3.fromRGB(255, 255, 0)
        targetHighlight.FillTransparency = 0.4
        targetHighlight.OutlineTransparency = 0
        targetHighlight.Parent = npc
    end
end

